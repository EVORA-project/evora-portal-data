    "7550": {
      "data": {
        "id": "7550",
        "type": "fairsharing_records",
        "attributes": {
          "created_at": "2026-01-26T08:50:14.267Z",
          "updated_at": "2026-07-01T08:22:23.202Z",
          "metadata": {
            "doi": "10.25504/FAIRsharing.75b055",
            "name": "European Viral Outbreak Response Alliance Ontology",
            "status": "ready",
            "contacts": [
              {
                "contact_name": "EVORA Helpdesk",
                "contact_email": "fairsharing-helpdesk@evora-project.eu",
                "contact_orcid": null
              }
            ],
            "homepage": "https://w3id.org/evorao",
            "citations": [],
            "identifier": 7550,
            "description": "The EVORAO Ontology provides a structured and harmonized vocabulary for describing shareable pathogens as characterized biological materials, along with their derived products and associated services, organized into collections. Developed within the EVORA project, it supports consistent metadata annotation across research infrastructures, promoting findability, accessibility, interoperability, and reusability (FAIR). By aligning with relevant standards and ontologies, EVORAO facilitates cross-domain collaboration, integration, and sharing of pathogenic resources and services to enhance pandemic preparedness and response. While initially focused on virology, EVORAO is designed to be extensible and also supports metadata harmonization for other pathogens. EVORAO is compatible with DCAT and DCAT-AP, making it well-suited for efficiently cataloguing pathogen collections and related resources.",
            "abbreviation": "EVORAO",
            "support_links": [
              {
                "url": "https://github.com/EVORA-project/evora-ontology",
                "name": " EVORA Ontology",
                "type": "Github"
              },
              {
                "url": "https://evora-project.github.io/evora-ontology/",
                "name": "EVORA Documentation",
                "type": "Help documentation"
              }
            ],
            "year_creation": 2025
          },
          "legacy_ids": [],
          "name": "FAIRsharing record for: European Viral Outbreak Response Alliance Ontology",
          "abbreviation": "EVORAO",
          "url": "https://fairsharing.org/10.25504/FAIRsharing.75b055",
          "doi": "10.25504/FAIRsharing.75b055",
          "fairsharing_licence": "https://creativecommons.org/licenses/by-sa/4.0/. Please link to https://fairsharing.org and https://api.fairsharing.org/img/fairsharing-attribution.svg for attribution.",
          "description": "This FAIRsharing record describes: The EVORAO Ontology provides a structured and harmonized vocabulary for describing shareable pathogens as characterized biological materials, along with their derived products and associated services, organized into collections. Developed within the EVORA project, it supports consistent metadata annotation across research infrastructures, promoting findability, accessibility, interoperability, and reusability (FAIR). By aligning with relevant standards and ontologies, EVORAO facilitates cross-domain collaboration, integration, and sharing of pathogenic resources and services to enhance pandemic preparedness and response. While initially focused on virology, EVORAO is designed to be extensible and also supports metadata harmonization for other pathogens. EVORAO is compatible with DCAT and DCAT-AP, making it well-suited for efficiently cataloguing pathogen collections and related resources.",
