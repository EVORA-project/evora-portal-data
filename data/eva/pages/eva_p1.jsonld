        }
      ],
      "EVORAO:unitCost": 3500,
      "EVORAO:unitCostCurrency": "EUR",
      "EVORAO:availability": "Available within 3 months",
      "EVORAO:canBeUsedToProduceGmo": false,
      "EVORAO:productPicture": {
        "@type": "EVORAO:Image",
        "EVORAO:contentUrl": "https://cdn.european-virus-archive.comhttps://cdn.european-virus-archive.com/sites/default/files/default_images/Service.jpg"
      },
      "EVORAO:riskGroup": {
        "@type": "EVORAO:RiskGroup",
        "dcterms:title": "No RG"
      },
      "EVORAO:technicalRecommendation": "We request that purified DNA/RNA is submitted for sequencing.  This can either be from tissue culture or clinical material, but we will need assurances that the the material is not infectious.  If RNA samples are submitted, please deplete genomic DNA and ribosomal RNA, as this will improve the proportion of viral sequence reads recovered (see Marston et al, 2013: https://dx.doi.org/10.1186/1471-2164-14-444 for our recommended extraction and depletion methods). \r\n\r\nSamples will be sequenced on the Illumina MiSeq platform and the consensus of the viral genome will be generated from the raw data using our in-house data processing pipeline.  Full details of the process are available on request.",
      "EVORAO:collection": {
        "@type": "EVORAO:Collection",
        "dcterms:title": "DEFRA"
      },
