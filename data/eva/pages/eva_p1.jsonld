      "dcterms:issued": "2026-06-26T09:59:38+02:00",
      "dcterms:modified": "2026-06-26T09:59:38+02:00",
      "dcterms:title": "Encapsidated RNA corresponding to the GP and NP of Bundibugyo ebolavirus sequence amplified by specific P&amp;P ",
      "dcterms:description": "The lyophilized, non infectious, encapsidated RNA (Armored RNA) contains the sequence of the GP and NP region from Bundibugyo ebolavirus and can be used as positive control for extraction and real time RT-PCR using specific Primers and probe ref:  001K-06404\r\nExtraction is mandatory before use in real time RT-PCR. \r\nPackaged for 100 Rxns, for RUO (Research Use Only). \r\nSOPs in the attached pdf.",
      "EVORAO:unitDefinition": "1 vial",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
        "dcterms:title": "detection kit"
      },
      "EVORAO:additionalCategory": [
        {
          "@type": "EVORAO:ProductCategory",
          "dcterms:title": "molecular detection kit"
        },
