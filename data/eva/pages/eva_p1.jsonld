      "EVORAO:refSku": "019S-06368",
      "@id": "urn:evorao:EVA:HPI:019S-06368",
      "EVORAO:accessPointUrl": "https://www.european-virus-archive.com/service/advanced-training-respiratory-syncytial-virus-wgs-using-oxford-nanopore-technology",
      "dcterms:issued": "2026-04-03T15:25:53+02:00",
      "dcterms:modified": "2026-04-03T15:36:56+02:00",
      "dcterms:title": "Advanced Training: Respiratory Syncytial Virus WGS Using Oxford Nanopore Technology",
      "dcterms:description": "The Public Health Laboratories of Hellenic Pasteur Institute (HPI) invite laboratory professionals to an intensive 4-day hands-on training course offering cutting-edge Next-Generation Sequencing (NGS) training for Respiratory Syncytial Virus (RSV), using Oxford Nanopore Technology. This program combines high-quality sequencing analysis with practical training modules, enabling participants to confidently implement and interpret RSV genomic analysis in their home laboratories. Participants will have the opportunity to engage in real-life RSV surveillance practises at the National Influenza Reference Laboratory of Southern Greece.\r\nParticipants will gain both theoretical knowledge and hands-on experience in key NGS workflows, including: \r\n1. Viral RNA extraction for NGS applications, \r\n2. Library preparation, \r\n3. Operation of Oxford Nanopore platforms, \r\n4. Data Processing Workflow: Basecalling, Alignment, and Assembly,\r\n5. NGS data quality control and validation, \r\n6. Basic bioinformatics pipelines for RSV genomics and variant analysis. \r\nA special rate will be offered for accommodation in a 4-star hotel located near the Hellenic Pasteur Institute.",
      "EVORAO:unitDefinition": "4 days",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
        "dcterms:title": "service"
      },
      "EVORAO:additionalCategory": [
