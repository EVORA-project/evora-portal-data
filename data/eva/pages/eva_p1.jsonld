      "EVORAO:provider": {
        "@type": "EVORAO:Provider",
        "foaf:name": "CSIRO"
      },
      "EVORAO:refSku": "024S-05652",
      "@id": "urn:evorao:EVA:CSIRO:024S-05652",
      "EVORAO:accessPointUrl": "https://www.european-virus-archive.com/service/training-course-applied-biosafety-and-biosecurity-heightened-and-maximum-containment",
      "dcterms:issued": "2024-02-19T10:16:44+01:00",
      "dcterms:modified": "2024-09-23T05:07:08+02:00",
      "dcterms:title": "Training course on applied biosafety and biosecurity in heightened and maximum containment laboratory facilities",
      "dcterms:description": "An in-depth theoretical and practical application of biosafety, biocontainment and biosecurity under the Australia/New Zealand standards and Australian regulatory framework for Biosecurity Containment and Physical Containment level 3 and 4 laboratory and animal facilities.",
      "EVORAO:unitDefinition": "Training course",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
        "dcterms:title": "service"
      },
      "EVORAO:additionalCategory": [
        {
          "@type": "EVORAO:ProductCategory",
          "dcterms:title": "derived product"
        },
        {
          "@type": "EVORAO:ProductCategory",
          "dcterms:title": "derived product"
        }
      ],
      "EVORAO:unitCost": 3400,
      "EVORAO:unitCostCurrency": "EUR",
      "EVORAO:availability": "Upon request",
      "EVORAO:canBeUsedToProduceGmo": false,
      "skos:note": "Course instruction will primarily be conducted in the high containment facility&nbsp; at ACDP, Geelong, Victoria Australia. Participants will receive a 5-day intensive course that includes interactive theoretical and practical experiences. Topics addressed will cover the application of biorisk management principles and practical experience in maintenance, validation and certification of critical biocontainment infrastructure. At location experience will include: decontamination and certification of ventilation system HEPA filters and biosafety cabinets; effluent collection pipework and plumbing vent line decontamination; effluent treatment systems and autoclave validation; room decontamination strategies &amp; validation; and room integrity (air-leakage/pressure decay) testing.Minimum of 6 or maximum 10 participants per course. Course price includes workshop expenses, daily lunches, tea breaks and a workshop dinner. Price does not include travel and accommodation costs. Please contact provider for 2025 course offerings.",
      "EVORAO:productPicture": {
        "@type": "EVORAO:Image",
        "EVORAO:contentUrl": "https://cdn.european-virus-archive.comhttps://cdn.european-virus-archive.com/sites/default/files/default_images/Service.jpg"
      },
