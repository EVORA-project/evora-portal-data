        "dcterms:description": "Synthetic origin, Natural origin",
        "EVORAO:biologicalPartOrigin": [
          {
            "@type": "EVORAO:NaturalPartOrigin",
            "EVORAO:partIdentification": "NL4-3",
            "EVORAO:sequence": {
              "@type": "EVORAO:Sequence",
              "EVORAO:sequenceReference": {
                "@type": "EVORAO:SequenceReference",
                "EVORAO:sequenceProvider": "GenBank",
                "EVORAO:accessionNumber": "AF324493Collection"
              }
            },
            "EVORAO:collectionDate": "2026-09-02",
            "EVORAO:countryOfCollection": {
              "@type": "EVORAO:Country",
              "dcterms:title": "United States of America (the)"
            }
          },
          {
            "@type": "EVORAO:SyntheticPartOrigin",
            "EVORAO:partIdentification": "Point mutations in the reverse transcriptase gene, position D67N",
            "EVORAO:modificationsFromTheReferenceSequences": true,
            "EVORAO:descriptionOfModificationsMadeFromTheReferenceSequences": "The sequence(s) of this synthetic product has been modified from the sequence listing provided as Genbank referencesDescription of modification(s) made from the reference sequence(s): The virus genome is derived from pNL-NF (pNL4-3 with shortened cellular flank) (doi.org/10.1016/j.jcv.2006.05.001). mutations as indicated in the name; backbone is NL-BX. A unique BamHI site was introduced 5’ of protease (ggagcc2207ggaTcc; A->S in Pol; E->D in Gag) and an XmaI site 3’ of protease (ccagga2589ccCggG). The original BamHI site as position 8465 was removed (GGATCC->GGATCA change silent in Env; L->S in Rev). Other mutations as indicated in the product name."
          }
        ],
        "EVORAO:recombinantMaterial": true,
        "EVORAO:biologicalSourceType": [
          true,
          false
        ]
      },
      "EVORAO:biosafetyRestrictions": "Plasmid contains the entire genome of HIV-1 with specific mutations in the reverse transcriptase gene, which can confer drug resistance to specific reverse transcriptase inhibitors. Might produce infectious virus after transfection into suitable human cells.",
      "EVORAO:canBeUsedToProduceGmo": false,
      "EVORAO:iataClassification": "NON DANGEROUS GOODS",
      "EVORAO:clonedNucleicAcid": true,
      "skos:note": "Plasmid based on pNL-BXTo&nbsp;identify the resistance(s) to&nbsp;antiretroviral drugs&nbsp;caused&nbsp;by the mutations&nbsp;present in this viral clone, use e.g. the&nbsp;„mutations list analysis“ function of the&nbsp;public HIV-Grade site&nbsp;at:www.hiv-grade.de/grade_new/",
      "EVORAO:observedMutations": "The virus genome is derived from pNL-NF (pNL4-3 with shortened cellular flank) (doi.org/10.1016/j.jcv.2006.05.001).\r\nmutations as indicated in the name; backbone is NL-BX.\r\nA unique BamHI site was introduced 5’ of protease (ggagcc2207ggaTcc; A->S in Pol; E->D in Gag) and an XmaI site 3’ of protease (ccagga2589ccCggG). \r\nThe original BamHI site as position 8465 was removed (GGATCC->GGATCA change silent in Env; L->S in Rev).\r\nOther mutations as indicated in the product name.",
      "EVORAO:clonedIntoPlasmid": {
        "@type": "EVORAO:ExpressionVector",
        "dcterms:title": "pUC18 (pvuII)"
      },
      "EVORAO:plasmidSelection": {
        "@type": "EVORAO:PlasmidSelection",
        "dcterms:title": "Ampicillin"
      },
      "EVORAO:qualityGrading": "Gold",
