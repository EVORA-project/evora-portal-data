      "dcterms:title": "Human anti-SARS-CoV-2 Spike protein (RBD) IgG1, monoclonal antibody (clone BCP004)",
      "dcterms:description": "Human monoclonal recombinant IgG1 targeting the RBD domain of SARS-CoV-2 Spike domain of the wild type strain, as determined by ELISA.",
      "EVORAO:unitDefinition": "1 vial, ~250 µL, 4,1 µg/mL",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
        "dcterms:title": "antibody"
