    },
    {
      "@type": "EVORAO:Bundle",
      "EVORAO:provider": {
        "@type": "EVORAO:Provider",
        "foaf:name": "AMU"
      },
      "EVORAO:refSku": "001B-04242",
      "@id": "urn:evorao:EVA:AMU:001B-04242",
      "EVORAO:accessPointUrl": "https://www.european-virus-archive.com/bundle/positive-control-encapsidated-rna-extraction-swab-urine-and-stool-samples-provided-primers",
      "dcterms:issued": "2021-06-11T12:00:17+02:00",
      "dcterms:modified": "2024-03-25T23:22:15+01:00",
      "dcterms:title": " Positive control for encapsidated RNA extraction from swab, urine and stool samples, provided with primers and probe",
      "dcterms:description": "Lyophilized encapsidated RNA (ArRNA) contains a region of the MS2 phage and is used as positive control for extraction and real time RT-PCR. The ArRNA is especially developed to be spiked in nasopharyngeal, salivary, urine and stool samples. \r\nProvided with Lyophilized ready-to-use primers and probe  for real time RT-PCR in a region of the MS2 phage.\r\nPositive control packaged for 100 Rxns; P&P packaged for 96 rxns in the form of 2x48 rxns\r\nDisclaimer: This product does not contain the polymerase.\r\nFor RUO (Research Use Only).",
