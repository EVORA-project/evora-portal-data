    {
      "@type": "EVORAO:NucleicAcid",
      "EVORAO:provider": {
        "@type": "EVORAO:Provider",
        "foaf:name": "FLI"
      },
      "EVORAO:refSku": "022N-03918",
      "@id": "urn:evorao:EVA:FLI:022N-03918",
      "EVORAO:accessPointUrl": "https://www.european-virus-archive.com/nucleic-acid/t7-driven-tetracistronic-ebola-virus-trvlp-system-expressing-lloviu-virus-0",
      "dcterms:issued": "2020-03-19T16:02:46+01:00",
      "dcterms:modified": "2022-03-15T15:36:58+01:00",
      "dcterms:title": "T7-driven tetracistronic Ebola virus trVLP system expressing a Lloviu virus glycoprotein and with a Nano-luciferase reporter (pT7.1-4cis-EBOV-vRNA-LLOV-GP-nluc), recombinant non-infectious system Ebola virus Mayinga / Lloviu virus (8 plasmids)",
      "dcterms:description": "Reverse genetics-based life cycle modelling system that allows modelling of Ebola virus genome replication and transcription, viral protein synthesis, virus assembly, budding, and Lloviu virus entry into target cells under BSL1 conditions. Consists of 1) a plasmid encoding a T7-driven tetracistronic minigenome encoding a Nano luciferase reporter and the Ebola virus proteins VP40 and VP24, and the Lloviu virus protein GP1,2; 2) expression plasmids for the Ebola virus protein NP, VP35, VP30, and L; and 3) expression plasmids for the accessory proteins T7 polymerase (for initial transcription of the minigenome), Tim1 (attachment factor) and firefly luciferase (as control). Access is restricted to non-commercial research institutions only. Further descriptions of the different trVLP systems can be found at https://www.fli.de/en/institutes/institute-of-molecular-virology-and-cell-biology-imvz/laboratories/laboratory-for-molecular-biology-of-filoviruses/",
      "EVORAO:unitDefinition": "8x 10 µl",
