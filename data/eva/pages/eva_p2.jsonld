    {
      "@type": "EVORAO:Antibody",
      "EVORAO:provider": {
        "@type": "EVORAO:Provider",
        "foaf:name": "ERASMUS-MC"
      },
      "EVORAO:refSku": "010A-05022",
      "@id": "urn:evorao:EVA:ERASMUS-MC:010A-05022",
      "EVORAO:accessPointUrl": "https://www.european-virus-archive.com/antibody-or-hybridoma/human-anti-sars-cov-2-spike-protein-s2-igg1-monoclonal-antibody-clone-bcp007",
      "dcterms:issued": "2023-05-16T10:45:16+02:00",
      "dcterms:modified": "2023-05-16T10:45:16+02:00",
      "dcterms:title": "Human anti-SARS-CoV-2 Spike protein (S2) IgG1, monoclonal antibody (clone BCP007)",
      "dcterms:description": "Human monoclonal recombinant IgG1 targeting the S2 domain of SARS-CoV-2 Spike as determined by ELISA.",
      "EVORAO:unitDefinition": "1 vial, ~200 µL, 51,6 µg/mL, 10,3 µg",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
        "dcterms:title": "antibody"
      },
      "EVORAO:additionalCategory": [
        {
          "@type": "EVORAO:ProductCategory",
          "dcterms:title": "diagnostic reagent"
        },
        {
          "@type": "EVORAO:ProductCategory",
          "dcterms:title": "derived product"
        }
      ],
      "EVORAO:unitCost": 500,
      "EVORAO:unitCostCurrency": "EUR",
      "EVORAO:availability": "Upon request",
      "EVORAO:antibodyCharacterizationMethod": "ELISA",
      "EVORAO:antibodyType": "Monoclonal",
      "EVORAO:antibodySpecificity": "This antibody is specific for the S2 domain of spike protein of SARS-CoV-2 virus.",
      "EVORAO:antibodyCharacterizationObservation": "The antibody showed reactivity towards the ancestral SARS-CoV-2 S-trimer(Sino Biological; 40589-V08H8) and S2 domain (Sino Biological; 40590-V08H1). Antibody showed high affinity for S2 as determined by ELISA. Binding to ancestral SARS-CoV-2 was also verified on protein array (Aguilar-Bretones et al., JCI, 2021). Binding to the Omicron BA.1 and BA.5 variants was detected, but not towards Delta. No cross-reactivity to hCoV-OC43, hCoV-NL63, hCoV-HKU1, hCoV-229E was detected. Antibody purity was assessed on SDS-PAGE and showed >95% purity.",
      "EVORAO:antibodyPurifiedByAffinity": true,
      "EVORAO:biosafetyRestrictions": "none",
      "EVORAO:iataClassification": "NON DANGEROUS GOODS",
      "EVORAO:previouslyKnownAs": "2019-nCoV",
      "EVORAO:productPicture": {
        "@type": "EVORAO:Image",
        "EVORAO:contentUrl": "https://cdn.european-virus-archive.comhttps://cdn.european-virus-archive.com/sites/default/files/default_images/hybridomAntibody.jpg"
      },
      "EVORAO:riskGroup": {
        "@type": "EVORAO:RiskGroup",
        "dcterms:title": "No RG"
      },
      "EVORAO:productionSystem": "Human SARS-CoV-2 Spike specific single B-cells were FACS sorted. After amplification the variable regions were cloned into Heavy and Light pFUSEss expression plasmids. The antibody was expressed by co-transfecting 293T cells with both plasmids. Secreted antibody was subsequently affinity purified and concentrated.",
      "EVORAO:shippingConditions": "Dry ice",
      "EVORAO:specificityDocumented": true,
      "EVORAO:targetedAntigen": "Virus:",
      "EVORAO:collection": {
        "@type": "EVORAO:Collection",
        "dcterms:title": "ERASMUS-MC"
      },
