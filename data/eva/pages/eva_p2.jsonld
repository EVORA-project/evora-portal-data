      "search:riskGroupLabel": "RG3",
      "search:isolationHostLabel": "Human",
      "search:collectionName": "BMC-SAS",
      "search:countryOfCollection": "Slovakia",
      "search:providerName": "BMC-SAS",
      "search:pathogenName": "SARS-CoV-2"
    },
