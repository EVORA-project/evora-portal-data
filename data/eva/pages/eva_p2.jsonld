      "EVORAO:accessPointUrl": "https://www.european-virus-archive.com/antibody-or-hybridoma/human-anti-sars-cov-2-spike-protein-s1-igg1-monoclonal-antibody-clone-bcp003",
      "dcterms:issued": "2023-05-16T10:34:35+02:00",
      "dcterms:modified": "2023-05-16T10:34:35+02:00",
      "dcterms:title": "Human anti-SARS-CoV-2 Spike protein (S1) IgG1, monoclonal antibody (clone BCP003)",
      "dcterms:description": "Human monoclonal recombinant IgG1 targeting the S1 domain of SARS-CoV-2 Spike domain of the wild type strain, as determined by ELISA.",
      "EVORAO:unitDefinition": "1 vial, ~300 µL, 76,6 µg/mL, 23 µg",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
        "dcterms:title": "antibody"
      },
      "EVORAO:additionalCategory": [
        {
          "@type": "EVORAO:ProductCategory",
          "dcterms:title": "diagnostic reagent"
        },
        {
          "@type": "EVORAO:ProductCategory",
          "dcterms:title": "derived product"
        }
      ],
      "EVORAO:unitCost": 500,
      "EVORAO:unitCostCurrency": "EUR",
      "EVORAO:availability": "Upon request",
      "EVORAO:antibodyCharacterizationMethod": "ELISA",
      "EVORAO:antibodyType": "Monoclonal",
      "EVORAO:antibodySpecificity": "This antibody is specific for the S1 domain of spike protein of SARS-CoV-2 virus.",
      "EVORAO:antibodyCharacterizationObservation": "The antibody showed reactivity towards ancestral SARS-CoV-2 S-trimer (Sino Biological; 40589-V08H8) positive and S1 (Sino Biological; 40591-V08H3) positive, but not to RBD (Sino Biological; 40592-V08H) as determined using ELISA. Antibody showed high affinity for S1 as determined by ELISA.  Binding to ancestral SARS-CoV-2 antigens was verified on protein micro-array (Aguilar-Bretones et al., JCI 2021).  Binding to SARS-CoV-2 Omicron BA.5 variant was detected but not to Delta and Omicron BA.1. No cross-reactivity towards hCoV-OC43, hCoV-NL63, hCoV-HKU1, hCoV-229E was detected. Antibody purity was assessed on SDS-PAGE and showed >95% purity.",
      "EVORAO:antibodyPurifiedByAffinity": true,
      "EVORAO:biosafetyRestrictions": "none",
      "EVORAO:iataClassification": "NON DANGEROUS GOODS",
      "EVORAO:previouslyKnownAs": "2019-nCoV",
      "EVORAO:productPicture": {
        "@type": "EVORAO:Image",
        "EVORAO:contentUrl": "https://cdn.european-virus-archive.comhttps://cdn.european-virus-archive.com/sites/default/files/default_images/hybridomAntibody.jpg"
      },
      "EVORAO:riskGroup": {
        "@type": "EVORAO:RiskGroup",
        "dcterms:title": "No RG"
      },
      "EVORAO:productionSystem": "Human SARS-CoV-2 Spike specific B-cell cultures were identified as described elsewhere (Aguilar-Bretones et al., JCI 2021). Paired variable Heavy and Light chain coding sequences were sequenced using NGS and the respective cDNAs were synthesized (gBlocks Gene Fragments, IDT) and cloned into Heavy and Light pFUSEss plasmids. The recombinant antibody was expressed by co-transfecting  both vectors in 293T cells. Secreted antibody was subsequently affinity purified and concentrated.",
      "EVORAO:shippingConditions": "Dry ice",
      "EVORAO:specificityDocumented": true,
      "EVORAO:targetedAntigen": "Virus:",
