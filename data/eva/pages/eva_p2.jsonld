      "EVORAO:provider": {
        "@type": "EVORAO:Provider",
        "foaf:name": "UNIBAS"
      },
      "EVORAO:refSku": "007V-04775",
      "@id": "urn:evorao:EVA:UNIBAS:007V-04775",
      "EVORAO:accessPointUrl": "https://www.european-virus-archive.com/virus/sars-cov-2-clone-wuhan-s-gene-omicron-ba5",
      "dcterms:issued": "2022-10-25T18:10:26+02:00",
      "dcterms:modified": "2024-01-03T18:31:51+01:00",
      "dcterms:title": "SARS-CoV-2 clone, Wuhan with S-Gene of Omicron BA.5",
      "dcterms:description": "Virus was produced from plasmid-based DNA segments of a common Wuhan strain. The S-gene was site-specifically replaced with a cloned BA.5-based S-gene sequence. S carries these mutations: T19I; LPPA24-27S; Del 69-70; G142D; V213G; G339D; S371F; S373P; S375F",
      "EVORAO:unitDefinition": "1 mL of titrated sterile virus stock",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
        "dcterms:title": "virus"
      },
      "EVORAO:additionalCategory": [
        {
          "@type": "EVORAO:ProductCategory",
          "dcterms:title": "diagnostic reagent"
        },
