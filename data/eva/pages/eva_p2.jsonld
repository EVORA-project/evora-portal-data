      "EVORAO:pathogenIdentification": {
        "@type": "EVORAO:PathogenIdentification",
        "EVORAO:pathogenName": {
          "@type": "EVORAO:VirusName",
          "dcterms:title": "Zaire ebolavirus"
        },
        "EVORAO:taxon": {
          "@type": "EVORAO:Taxon",
          "dcterms:title": "Zaire ebolavirus"
        },
        "EVORAO:pathogenType": "Virus",
        "EVORAO:hostType": "Animal, Human"
      },
      "search:sku": "022N-03919",
      "search:title": "T7-driven tetracistronic Ebola virus trVLP system expressing no glycoprotein and with a Renilla-luciferase reporter (pT7-4cis-EBOV-vRNA-dGP-hrLuc), recombinant non-infectious system Ebola virus Mayinga (8 plasmids)",
      "search:description": "Reverse genetics-based life cycle modelling system that can serve as negative control and is best used together with other trVLP systems that allows modelling of Ebola virus genome replication and transcription, viral protein synthesis, virus assembly, budding, and entry into target cells under BSL1 conditions. Consists of 1) a plasmid encoding a T7-driven tetracistronic minigenome encoding a Renilla luciferase reporter and the Ebola virus proteins VP40 and VP24; 2) expression plasmids for the Ebola virus protein NP, VP35, VP30, and L; and 3) expression plasmids for the accessory proteins T7 polymerase (for initial transcription of the minigenome), Tim1 (attachment factor) and firefly luciferase (as control). Allows insertion of other glycoprotein ORFs through two BsmBI sites. Access is restricted to non-commercial research institutions only. Further descriptions of the different trVLP systems can be found at https://www.fli.de/en/institutes/institute-of-molecular-virology-and-cell-biology-imvz/laboratories/laboratory-for-molecular-biology-of-filoviruses/",
      "search:taxonLabel": "Zaire ebolavirus",
      "search:publisherName": "European Virus Archive",
      "search:riskGroupLabel": "RG1",
      "search:collectionName": "FLI",
      "search:providerName": "FLI",
      "search:pathogenName": "Zaire ebolavirus"
    },
    {
      "@type": "EVORAO:NucleicAcid",
      "EVORAO:provider": {
        "@type": "EVORAO:Provider",
        "foaf:name": "FLI"
      },
      "EVORAO:refSku": "022N-03918",
      "@id": "urn:evorao:EVA:FLI:022N-03918",
      "EVORAO:accessPointUrl": "https://www.european-virus-archive.com/nucleic-acid/t7-driven-tetracistronic-ebola-virus-trvlp-system-expressing-lloviu-virus-0",
      "dcterms:issued": "2020-03-19T16:02:46+01:00",
      "dcterms:modified": "2022-03-15T15:36:58+01:00",
      "dcterms:title": "T7-driven tetracistronic Ebola virus trVLP system expressing a Lloviu virus glycoprotein and with a Nano-luciferase reporter (pT7.1-4cis-EBOV-vRNA-LLOV-GP-nluc), recombinant non-infectious system Ebola virus Mayinga / Lloviu virus (8 plasmids)",
      "dcterms:description": "Reverse genetics-based life cycle modelling system that allows modelling of Ebola virus genome replication and transcription, viral protein synthesis, virus assembly, budding, and Lloviu virus entry into target cells under BSL1 conditions. Consists of 1) a plasmid encoding a T7-driven tetracistronic minigenome encoding a Nano luciferase reporter and the Ebola virus proteins VP40 and VP24, and the Lloviu virus protein GP1,2; 2) expression plasmids for the Ebola virus protein NP, VP35, VP30, and L; and 3) expression plasmids for the accessory proteins T7 polymerase (for initial transcription of the minigenome), Tim1 (attachment factor) and firefly luciferase (as control). Access is restricted to non-commercial research institutions only. Further descriptions of the different trVLP systems can be found at https://www.fli.de/en/institutes/institute-of-molecular-virology-and-cell-biology-imvz/laboratories/laboratory-for-molecular-biology-of-filoviruses/",
      "EVORAO:unitDefinition": "8x 10 µl",
