      "EVORAO:accessPointUrl": "https://www.european-virus-archive.com/service/access-virus-whole-genome-sequencing-service-apha",
      "dcterms:issued": "2016-11-21T17:53:56+01:00",
      "dcterms:modified": "2024-10-01T14:34:33+02:00",
      "dcterms:title": "Access to virus whole genome sequencing service at APHA",
      "dcterms:description": "Virus whole genome sequencing",
      "EVORAO:unitDefinition": "Provision of consensus genome sequence for one virus sample.  This is a guide price and a quote will be provided upon request.  Economies of scale may be applicable when sequencing multiple samples at the same time.",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
        "dcterms:title": "service"
      },
      "EVORAO:additionalCategory": [
        {
          "@type": "EVORAO:ProductCategory",
