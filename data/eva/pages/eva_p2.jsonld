      "search:sku": "007V-04776",
      "search:title": "SARS-CoV-2 clone, Wuhan with S-Gene of Omicron BA.2",
      "search:description": "Virus has been produced from plasmid-based DNA segments of a common Wuhan strain. The S-gene was site-specifically replaced with a cloned BA.2-based S-gene sequence. S carries these mutations: T19I; LPPA24-27S; G142D; V213G; G339D; S371F; S373P; S375F; T376A; D405N; R408S; K417N; N440K; S477N; T478K; E484A; Q493R; Q498R; N501Y; Y505H; D614G; H655Y; N679K; P681H; N764K; D796Y; Q954H; N969K",
      "search:taxonLabel": "Betacoronavirus",
      "search:publisherName": "European Virus Archive",
      "search:riskGroupLabel": "RG3",
      "search:collectionName": "UNIBAS",
      "search:providerName": "UNIBAS",
      "search:pathogenName": "SARS-CoV-2, Severe acute respiratory syndrome coronavirus 2"
    },
