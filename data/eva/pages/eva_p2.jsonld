      "@id": "urn:evorao:EVA:CSIRO:024S-05946",
      "EVORAO:accessPointUrl": "https://www.european-virus-archive.com/service/training-course-applied-biosafety-maximum-containment-suited-laboratory",
      "dcterms:issued": "2024-06-06T08:50:27+02:00",
      "dcterms:modified": "2024-09-23T05:07:56+02:00",
      "dcterms:title": "Training course on applied biosafety in maximum containment in a suited laboratory.",
      "dcterms:description": "Course instruction will be conducted in the high containment facility at ACDP, Geelong, Victoria, Australia. Participants will receive a 5-day intensive course that includes interactive theoretical and practical experiences. Topics addressed will include introduction to BSL4 suited laboratories, regulatory frameworks, operational oversight, engineering controls and maintenance considerations. Practical components of this course will include user experience in two types of encapsulated suits, normal entry/exit procedures as well as emergency responses to various scenarios (such as emergency egress and medical emergency) and suit repair. This training course will be conducted in both a dedicated training laboratory and a functional BSL4 laboratory (down for maintenance). Please get in touch with provider for 2025 course offerings.",
      "EVORAO:unitDefinition": "Training course",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
        "dcterms:title": "service"
      },
      "EVORAO:additionalCategory": [
        {
          "@type": "EVORAO:ProductCategory",
          "dcterms:title": "derived product"
        },
        {
          "@type": "EVORAO:ProductCategory",
          "dcterms:title": "derived product"
        }
      ],
      "EVORAO:unitCost": 6000,
      "EVORAO:unitCostCurrency": "EUR",
      "EVORAO:availability": "Upon request",
      "EVORAO:canBeUsedToProduceGmo": false,
      "skos:note": "Maximum of 6 participants per course. Course price includes workshop expenses, daily lunches, tea breaks and a workshop dinner. Price does not include travel and accommodation costs. Please contact provider for 2025 course offerings.",
      "EVORAO:productPicture": {
        "@type": "EVORAO:Image",
        "EVORAO:contentUrl": "https://cdn.european-virus-archive.comhttps://cdn.european-virus-archive.com/sites/default/files/default_images/Service.jpg"
      },
