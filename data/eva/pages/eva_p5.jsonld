    {
      "@type": "EVORAO:Service",
      "EVORAO:provider": {
        "@type": "EVORAO:Provider",
        "foaf:name": "ERASMUS-MC"
      },
      "EVORAO:refSku": "011S-03120",
      "@id": "urn:evorao:EVA:ERASMUS-MC:011S-03120",
      "EVORAO:accessPointUrl": "https://www.european-virus-archive.com/service/serological-tools-detect-arbo-viruses",
      "dcterms:issued": "2018-09-11T14:52:26+02:00",
      "dcterms:modified": "2018-09-11T14:52:26+02:00",
      "dcterms:title": "Serological tools to detect ARBO-viruses",
      "dcterms:description": "In this 3-day course the basic principles of serological testing against ARBO viruses will be addressed by a combination of lectures, demonstration and hands-on training. Participants will visit the Viroscience clinical virology lab, where they will perform all laboratory techniques including ELISA, Immunofluorescence and virus neutralization. Attention will be given to serological testing in cerebrospinal fluid, including the calculation of an antibody index. Other topics may include : cell culture, biosafety procedures, ELISA formats, different virus neutralization tests, immunofluorescence and staining of cells, calculation of titers, assay validation and quality control.",
      "EVORAO:unitDefinition": "3 days",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
        "dcterms:title": "service"
      },
      "EVORAO:additionalCategory": [
        {
          "@type": "EVORAO:ProductCategory",
          "dcterms:title": "derived product"
        }
      ],
