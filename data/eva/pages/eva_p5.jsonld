        "foaf:name": "ERASMUS-MC"
      },
      "EVORAO:refSku": "011S-02851",
      "@id": "urn:evorao:EVA:ERASMUS-MC:011S-02851",
      "EVORAO:accessPointUrl": "https://www.european-virus-archive.com/service/training-course-pcr-workflow-and-virus-typing",
      "dcterms:issued": "2018-05-01T21:09:08+02:00",
      "dcterms:modified": "2018-05-01T21:09:08+02:00",
      "dcterms:title": "Training Course: PCR workflow and virus typing",
      "dcterms:description": "In this 3-day course the basic principles of routine virus typing will be addressed by a combination of lectures, demonstration and hands-on training. Participants will visit the Viroscience clinical virology lab, where they will perform all required laboratory and analysis procedures for routine typing of viruses. Typing of enteroviruses will be used as an example, but the general procedures are applicable to typing of other viruses also. After this course participants should have sufficient knowledge to introduce routine typing of viruses in their own laboratory. Special attention will be given to quality control and assay validation.\r\nTopics included:\r\n-\tPCR workflow\r\n-\tNucleic Acid isolation \r\n-\tReverse transcription and PCR\r\n-\tSequencing and sequence analysis\r\n-\tBasic phylogeny for virus typing\r\n-\tAssay validation and Quality control in molecular diagnostics",
      "EVORAO:unitDefinition": "3-day course",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
        "dcterms:title": "service"
      },
      "EVORAO:additionalCategory": [
        {
          "@type": "EVORAO:ProductCategory",
          "dcterms:title": "derived product"
        }
      ],
      "EVORAO:unitCost": 1500,
      "EVORAO:unitCostCurrency": "EUR",
      "EVORAO:availability": "Upon request",
      "EVORAO:biosafetyRestrictions": "BSL2",
      "EVORAO:canBeUsedToProduceGmo": false,
      "EVORAO:productPicture": {
