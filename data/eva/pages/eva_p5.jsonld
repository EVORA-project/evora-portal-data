      "dcterms:issued": "2020-03-17T10:17:30+01:00",
      "dcterms:modified": "2020-05-20T14:54:40+02:00",
      "dcterms:title": "SARS-CoV-2 RdRp gene stabilized RNA as positive control: shipping at Room Temperature",
      "dcterms:description": "Lyophilized encapsidated RNA for SARS-CoV-2 (2019-nCoV) real time RT-PCR targeting region of the RdRp gene, for 25 Rxns (Target designed by Charité Universitätsmedizin Berlin). \r\nThe encapsidated RNA has been stabilized to serve as positive control for extraction and real time RT-PCR. Extraction is mandatory before use in real time RT-PCR. SOPs in the attached pdf. \r\nFor RUO (Research Use Only)",
      "EVORAO:unitDefinition": "1 vial",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
        "dcterms:title": "detection kit"
      },
      "EVORAO:additionalCategory": [
        {
          "@type": "EVORAO:ProductCategory",
          "dcterms:title": "molecular detection kit"
        },
        {
          "@type": "EVORAO:ProductCategory",
          "dcterms:title": "derived product"
        },
        {
          "@type": "EVORAO:ProductCategory",
          "dcterms:title": "detection kit (for RUO)"
        }
      ],
      "EVORAO:unitCost": 50,
      "EVORAO:unitCostCurrency": "EUR",
      "EVORAO:availability": "In stock",
      "EVORAO:canBeUsedToProduceGmo": false,
      "EVORAO:iataClassification": "NON DANGEROUS GOODS",
      "EVORAO:productPicture": {
        "@type": "EVORAO:Image",
        "EVORAO:contentUrl": "https://cdn.european-virus-archive.comhttps://cdn.european-virus-archive.com/sites/default/files/default_images/HeLa2_381b.jpg"
      },
      "EVORAO:riskGroup": {
        "@type": "EVORAO:RiskGroup",
        "dcterms:title": "No RG"
      },
      "EVORAO:shippingConditions": "Room Temperature",
      "EVORAO:standardOperatingProcedureFile": "https://www.european-virus-archive.com/sites/default/files/detection_kit/ArRNASOP.pdf",
      "EVORAO:specificity": "SOP",
      "EVORAO:specificityDocumented": true,
      "EVORAO:storageConditions": "Freeze Dried (-20C)",
