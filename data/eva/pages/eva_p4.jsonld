    {
      "@type": "EVORAO:NucleicAcid",
      "EVORAO:provider": {
        "@type": "EVORAO:Provider",
        "foaf:name": "IP"
      },
      "EVORAO:refSku": "014N-02062",
      "@id": "urn:evorao:EVA:IP:014N-02062",
      "EVORAO:accessPointUrl": "https://www.european-virus-archive.com/nucleic-acid/h5n8-ivt-rna-hana-assay",
      "dcterms:issued": "2017-01-18T18:43:13+01:00",
      "dcterms:modified": "2022-08-31T14:22:17+02:00",
      "dcterms:title": "H5N8 IVT-RNA HA&amp;NA assay",
      "dcterms:description": "In vitro transcriped RNA of partial hemagglutinin and neuraminidase genes. Positive control for diagnostic PCR screening (H5N8)",
      "EVORAO:unitDefinition": "lyophilised",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
        "dct:title": "nucleic acid"
      },
      "EVORAO:additionalCategory": [
        {
          "@type": "EVORAO:ProductCategory",
