      "EVORAO:canBeUsedToProduceGmo": false,
      "EVORAO:iataClassification": "Category B, UN3373",
      "EVORAO:identificationTechnique": "RT-PCR followed by sequencing of the amplified product.",
      "EVORAO:infectivity": "Infectivity tested and quantified",
      "EVORAO:infectivityTest": "Infectivity was proven by plaque titration. Infectious titre was determined to be 2.1x 10^6 PFU/ml.",
      "EVORAO:mycoplasmicContent": "Mycoplasma free",
      "EVORAO:passage": "Passaged 18 times on suckling mice in 1991 and stored freeze-dried. New stock prepared by one passage on Vero E6 cells on 11th October 2010.",
      "EVORAO:qualityGrading": "Silver",
      "EVORAO:productPicture": {
        "@type": "EVORAO:Image",
        "EVORAO:contentUrl": "https://cdn.european-virus-archive.comhttps://cdn.european-virus-archive.com/sites/default/files/default_images/VirusProduct_381_0.jpg"
