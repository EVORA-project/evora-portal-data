    {
      "@type": "EVORAO:NucleicAcid",
      "EVORAO:provider": {
        "@type": "EVORAO:Provider",
        "foaf:name": "FLI"
      },
      "EVORAO:refSku": "022N-03908",
      "@id": "urn:evorao:EVA:FLI:022N-03908",
      "EVORAO:accessPointUrl": "https://www.european-virus-archive.com/nucleic-acid/t7-driven-tetracistronic-ebola-virus-trvlp-system-renilla-luciferase-reporter-pt71-4cis",
      "dcterms:issued": "2020-03-19T14:34:36+01:00",
      "dcterms:modified": "2021-02-23T15:29:11+01:00",
      "dcterms:title": "T7-driven tetracistronic Ebola virus trVLP system with a Renilla-luciferase reporter (pT7.1-4cis-EBOV-vRNA-hrLuc, pTH5264), recombinant non-infectious virus system for Ebola virus Mayinga (8 Plasmids)",
      "dcterms:description": "Reverse genetics-based life cycle modelling system that allows modelling of Ebola virus genome replication and transcription, viral protein synthesis, virus assembly, budding, and entry into target cells under BSL1 conditions. Consists of 1) a plasmid encoding a T7-driven tetracistronic minigenome encoding a Renilla luciferase reporter and the Ebola virus proteins VP40, VP24, and GP1,2; 2) expression plasmids for the Ebola virus protein NP, VP35, VP30, and L; and 3) expression plasmids for the accessory proteins T7 polymerase (for initial transcription of the minigenome), Tim1 (attachment factor) and firefly luciferase (as control). Access is restricted to non-commercial research institutions only. Further descriptions of the different trVLP systems can be found at https://www.fli.de/en/institutes/institute-of-molecular-virology-and-cell-biology-imvz/laboratories/laboratory-for-molecular-biology-of-filoviruses/",
      "EVORAO:unitDefinition": "8x 10 µl",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
        "dcterms:title": "nucleic acid"
      },
      "EVORAO:additionalCategory": [
        {
          "@type": "EVORAO:ProductCategory",
          "dcterms:title": "derived product"
        },
        {
          "@type": "EVORAO:ProductCategory",
          "dcterms:title": "cloned nucleic acid"
        }
      ],
      "EVORAO:unitCost": 900,
      "EVORAO:unitCostCurrency": "EUR",
      "EVORAO:availability": "In stock",
      "EVORAO:biologicalMaterialOrigin": {
        "@type": "EVORAO:BiologicalMaterialOrigin",
        "dcterms:description": "Synthetic origin"
      },
      "EVORAO:biosafetyRestrictions": "The risk group classification of this life cycle modelling system can differ from country to country!",
      "EVORAO:canBeUsedToProduceGmo": true,
      "EVORAO:iataClassification": "NON DANGEROUS GOODS",
      "EVORAO:identificationTechnique": "sequencing",
      "EVORAO:clonedNucleicAcid": true,
      "EVORAO:clonedIntoPlasmid": [
        {
          "@type": "EVORAO:ExpressionVector",
          "dcterms:title": "pT7"
        },
