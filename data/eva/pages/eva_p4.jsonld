      "EVORAO:accessPointUrl": "https://www.european-virus-archive.com/virus/sindv183-sk2",
      "dcterms:issued": "2015-09-25T12:38:07+02:00",
      "dcterms:modified": "2021-01-15T14:55:51+01:00",
      "dcterms:title": "SINDV183-SK2",
      "dcterms:description": "This was originally supposed to be isolated in 1974 from a hamster Cricetus Cricetus, isolated and passaged on suckling mice and stored freeze-dried. This Sindbis virus[183-183-SK2] is preserved under Viral Storage Medium -80C.Tests for the presence of mycoplasmae were negative. To confirm its identity the virus has been partly sequenced.",
      "EVORAO:unitDefinition": "1 ml (2 vials of 0,5 ml)",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
        "dct:title": "virus"
      },
