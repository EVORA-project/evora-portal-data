      },
      "EVORAO:refSku": "011V-00884",
      "@id": "urn:evorao:EVA:ERASMUS-MC:011V-00884",
      "EVORAO:accessPointUrl": "https://www.european-virus-archive.com/virus/phocid-herpes-virus-type-1",
      "dcterms:issued": "2016-04-04T12:59:17+02:00",
      "dcterms:modified": "2020-12-31T11:42:17+01:00",
      "dcterms:title": "Phocid herpes virus type 1",
      "dcterms:description": "Virus culture stock of Phocid Herpes Virus type 1 (PhHV-1) to be used for research or an internal NAT DNA control",
      "EVORAO:unitDefinition": "500 µL culture supernatant",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
        "dcterms:title": "virus"
      },
      "EVORAO:additionalCategory": [
        {
          "@type": "EVORAO:ProductCategory",
