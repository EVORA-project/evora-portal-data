      },
      "EVORAO:unitCost": 500,
      "EVORAO:unitCostCurrency": "EUR",
      "EVORAO:availability": "In stock",
      "EVORAO:biologicalMaterialOrigin": {
        "@type": "EVORAO:BiologicalMaterialOrigin",
        "dcterms:description": "Natural origin",
        "EVORAO:biologicalPartOrigin": {
          "@type": "EVORAO:NaturalPartOrigin",
