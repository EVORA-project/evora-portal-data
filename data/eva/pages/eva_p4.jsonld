      "dcterms:issued": "2015-09-25T12:38:07+02:00",
      "dcterms:modified": "2021-01-15T14:54:35+01:00",
      "dcterms:title": "SFV-prototype",
      "dcterms:description": "Semliki forest virus original isolate. This Semliki forest virus[original.] is preserved under Viral Storage Medium -80C.Tests for the presence of mycoplasmae were negative. To confirm its identity the virus has been partly sequenced.",
      "EVORAO:unitDefinition": "1 ml (2 vials of 0.5ml)",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
        "dct:title": "virus"
      },
      "EVORAO:additionalCategory": {
