      "dcterms:issued": "2015-09-25T12:38:15+02:00",
      "dcterms:modified": "2021-01-15T14:31:18+01:00",
      "dcterms:title": "TRIBV",
      "dcterms:description": "Prototype virus. This Tribec virus[Tribec-Tribec] is preserved under Viral Storage Medium -80C.Tests for the presence of mycoplasmae were negative. To confirm its identity the virus has been partly sequenced.",
      "EVORAO:unitDefinition": "1ml (2 vials of 0.5ml)",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
