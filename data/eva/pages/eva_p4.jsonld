      "dcterms:issued": "2015-09-25T12:38:15+02:00",
      "dcterms:modified": "2021-01-11T15:35:58+01:00",
      "dcterms:title": "LGTV",
      "dcterms:description": "Langat virus - original isolate. This Langat virus is preserved under Viral Storage Medium -80C.Tests for the presence of mycoplasmae were negative. To confirm its identity the virus has been partly sequenced.",
      "EVORAO:unitDefinition": "1 ml (2vials of 0,5 ml)",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
        "dct:title": "virus"
      },
      "EVORAO:additionalCategory": {
