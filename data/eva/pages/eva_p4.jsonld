      "EVORAO:canBeUsedToProduceGmo": false,
      "EVORAO:iataClassification": "Category A, UN2814",
      "EVORAO:identificationTechnique": "RT-PCR followed by sequencing of the amplified product.",
      "EVORAO:infectivity": "Infectivity tested and quantified",
      "EVORAO:infectivityTest": "Infectivity was proven by plaque titration. Infectious titre was determined to be 2x 10^6 PFU/ml.",
      "EVORAO:mycoplasmicContent": "Mycoplasma free",
      "EVORAO:passage": "Passaged 60 times on suckling mice and 2 times on PS cells in 1997 and stored freeze-dried. New stock prepared by one passage on Vero E6 cells on 27th September 2010.",
      "EVORAO:qualityGrading": "Silver",
      "EVORAO:productPicture": {
        "@type": "EVORAO:Image",
