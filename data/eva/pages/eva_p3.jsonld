      "EVORAO:pathogenIdentification": {
        "@type": "EVORAO:PathogenIdentification",
        "EVORAO:pathogenName": {
          "@type": "EVORAO:VirusName",
          "dcterms:title": "Lloviu cuevavirus"
        },
        "EVORAO:taxon": {
          "@type": "EVORAO:Taxon",
