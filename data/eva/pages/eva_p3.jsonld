      "EVORAO:refSku": "027K-04207",
      "@id": "urn:evorao:EVA:DSMZ:027K-04207",
      "EVORAO:accessPointUrl": "https://www.european-virus-archive.com/detection-kit/elisa-survey-package-legume-viruses",
      "dcterms:issued": "2021-05-20T19:10:11+02:00",
      "dcterms:modified": "2021-06-15T18:00:29+02:00",
      "dcterms:title": "ELISA survey package for legume viruses",
      "dcterms:description": "Many regularly cultivated field crops are affected by viral pathogens, especially if they are grown on a large scale, which usually results in significant yield reductions. As a first step, it is important to obtain an overview of which viruses are involved in order to counter this problem. To obtain a representative overview, it is necessary to investigate a significant number of samples. This survey package contains the ELISA antibodies needed to test up to 500 individual samples for eight of the most common viruses found in legumes: Alfalfa mosaic virus (AMV), Bean common mosaic virus (BCMV), Bean common mosaic necrosis virus (BCMNV), Bean yellow mosaic virus (BYMV), Cucumber mosaic virus (CMV), Cowpea mild mottle virus (CABMV), Soybean mosaic virus (SMV) and Cowpea aphid borne mosaic virus (CABMV).",
      "EVORAO:unitDefinition": "Package contains all antibodies (IgGs and conjugates) required for the analysis of up to 500 samples (or 250 samples analysed in duplicate wells) by ELISA (200 µl scale) plus 2 positive controls per virus (2 ml).",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
        "dcterms:title": "detection kit"
      },
      "EVORAO:additionalCategory": [
        {
          "@type": "EVORAO:ProductCategory",
          "dcterms:title": "ELISA"
        },
        {
          "@type": "EVORAO:ProductCategory",
          "dcterms:title": "derived product"
        },
        {
          "@type": "EVORAO:ProductCategory",
          "dcterms:title": "detection kit (for RUO)"
        }
      ],
      "EVORAO:unitCost": 1888,
      "EVORAO:unitCostCurrency": "EUR",
