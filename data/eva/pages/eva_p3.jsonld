      "EVORAO:accessPointUrl": "https://www.european-virus-archive.com/antibody-or-hybridoma/mers-cov-single-chain-antibody-hcab-83",
      "dcterms:issued": "2018-06-13T11:24:33+02:00",
      "dcterms:modified": "2020-12-31T15:27:26+01:00",
      "dcterms:title": "MERS-CoV single chain antibody HCAb-83",
      "dcterms:description": "HCAb-83 is a MERS-CoV specific  camel/human chimeric heavy chain only antibody (HCAb) - composed of the camel VHH-83 linked to a human Fc domain lacking the CH1 exon Through direct cloning and expression of the variable heavy chains (VHHs) of HCAbs from the bone marrow of MERS-CoV infected dromedaries, MERS-CoV specific VHHs or nanobodies were produced. VHH-83 binds with exceptionally high affinity to the receptor binding domain of the viral spike protein. In vitro, HCAb-83 efficiently blocks virus entry at picomolar concentrations",
      "EVORAO:unitDefinition": "50 µg",
      "EVORAO:category": {
        "@type": "EVORAO:ProductCategory",
        "dcterms:title": "antibody"
      },
