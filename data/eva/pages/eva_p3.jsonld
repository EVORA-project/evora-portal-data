      "search:sku": "007V-03121",
      "search:title": "Dengue virus, Type 1",
      "search:description": "Infectious cell culture supernatant. This Dengue virus, serotype 1 (strain 780/18) is preserved under Viral Storage Medium -80C. The virus is mycoplasma free. To confirm its identity the virus has been sequenced.",
      "search:taxonLabel": "Dengue virus",
      "search:publisherName": "European Virus Archive",
      "search:riskGroupLabel": "RG3",
      "search:isolationHostLabel": "patient serum",
